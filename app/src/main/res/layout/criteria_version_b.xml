<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- En Üst Başlık -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kriter Değerlendirme Sayfası"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="4dp"
        android:textColor="#2E7D32" />

    <!-- Takım Başlıkları - İki Renkli Bölge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="0dp">

        <!-- Takım 1 - Açık Mavi Bölge -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:background="@drawable/black_border">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="TAKIM 1"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#E3F2FD"
                android:textColor="#1976D2"
                android:layout_margin="3dp" />

        </FrameLayout>

        <!-- Takım 2 - Açık Yeşil Bölge -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:background="@drawable/black_border">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="TAKIM 2"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#F1F8E9"
                android:textColor="#388E3C"
                android:layout_margin="3dp" />

        </FrameLayout>

    </LinearLayout>

    <!-- Büyük Scroll Çerçeve Pencere -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/black_border">

        <!-- İki Renkli Arkaplan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:layout_margin="4dp">

            <!-- Sol Yarı - Açık Mavi -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#E3F2FD" />

            <!-- Sağ Yarı - Açık Yeşil -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#F1F8E9" />

        </LinearLayout>

        <!-- Vertical ScrollView -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:scrollbars="vertical"
            android:background="@android:color/transparent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Kriter 1 Çerçevesi -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/black_border">

                    <!-- İki Renkli Arkaplan -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:layout_margin="2dp">

                        <!-- Sol Yarı - Açık Mavi -->
                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#E3F2FD" />

                        <!-- Sağ Yarı - Açık Yeşil -->
                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#F1F8E9" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@android:color/transparent"
                        android:layout_margin="2dp"
                        android:padding="12dp">

                        <!-- Kriter Başlık Satırı -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- Kriter Adı -->
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Melodi Kalitesi"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#2E7D32" />

                            <!-- Checkbox -->
                            <CheckBox
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true" />

                        </LinearLayout>

                        <!-- Ayrı Ayrı Puanlama Alanı -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="12dp"
                            android:visibility="visible">

                            <!-- Takım 1 Dropdown -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="8dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Takım 1 Puanı"
                                    android:textSize="12sp"
                                    android:textColor="#1976D2"
                                    android:gravity="center"
                                    android:layout_marginBottom="4dp" />

                                <Spinner
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:background="#E3F2FD"
                                    android:entries="@array/score_options" />

                            </LinearLayout>

                            <!-- Takım 2 Dropdown -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="8dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Takım 2 Puanı"
                                    android:textSize="12sp"
                                    android:textColor="#388E3C"
                                    android:gravity="center"
                                    android:layout_marginBottom="4dp" />

                                <Spinner
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:background="#F1F8E9"
                                    android:entries="@array/score_options" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </FrameLayout>

                <!-- Kriter 2 Çerçevesi (Kapalı Örnek) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/black_border">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#F5F5F5"
                        android:layout_margin="2dp"
                        android:padding="12dp"
                        android:alpha="0.6">

                        <!-- Kriter Başlık Satırı -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- Kriter Adı -->
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Ritim Uyumu"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#757575" />

                            <!-- Checkbox -->
                            <CheckBox
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false" />

                        </LinearLayout>

                    </LinearLayout>

                </FrameLayout>

                <!-- Kriter 3 Çerçevesi -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/black_border">

                    <!-- İki Renkli Arkaplan -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:layout_margin="2dp">

                        <!-- Sol Yarı - Açık Mavi -->
                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#E3F2FD" />

                        <!-- Sağ Yarı - Açık Yeşil -->
                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#F1F8E9" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@android:color/transparent"
                        android:layout_margin="2dp"
                        android:padding="12dp">

                        <!-- Kriter Başlık Satırı -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- Kriter Adı -->
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Vokal Performansı"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#2E7D32" />

                            <!-- Checkbox -->
                            <CheckBox
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true" />

                        </LinearLayout>

                        <!-- Ayrı Ayrı Puanlama Alanı -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="12dp"
                            android:visibility="visible">

                            <!-- Takım 1 Dropdown -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="8dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Takım 1 Puanı"
                                    android:textSize="12sp"
                                    android:textColor="#1976D2"
                                    android:gravity="center"
                                    android:layout_marginBottom="4dp" />

                                <Spinner
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:background="#E3F2FD"
                                    android:entries="@array/score_options" />

                            </LinearLayout>

                            <!-- Takım 2 Dropdown -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="8dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Takım 2 Puanı"
                                    android:textSize="12sp"
                                    android:textColor="#388E3C"
                                    android:gravity="center"
                                    android:layout_marginBottom="4dp" />

                                <Spinner
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:background="#F1F8E9"
                                    android:entries="@array/score_options" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </FrameLayout>

                <!-- Kriter 4 Çerçevesi -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/black_border">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#FFFFFF"
                        android:layout_margin="2dp"
                        android:padding="12dp">

                        <!-- Kriter Başlık Satırı -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- Kriter Adı -->
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Sahne Performansı"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#2E7D32" />

                            <!-- Checkbox -->
                            <CheckBox
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true" />

                        </LinearLayout>

                        <!-- Ayrı Ayrı Puanlama Alanı -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="12dp"
                            android:visibility="visible">

                            <!-- Takım 1 Dropdown -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="8dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Takım 1 Puanı"
                                    android:textSize="12sp"
                                    android:textColor="#1976D2"
                                    android:gravity="center"
                                    android:layout_marginBottom="4dp" />

                                <Spinner
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:background="#E3F2FD"
                                    android:entries="@array/score_options" />

                            </LinearLayout>

                            <!-- Takım 2 Dropdown -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="8dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Takım 2 Puanı"
                                    android:textSize="12sp"
                                    android:textColor="#388E3C"
                                    android:gravity="center"
                                    android:layout_marginBottom="4dp" />

                                <Spinner
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:background="#F1F8E9"
                                    android:entries="@array/score_options" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </FrameLayout>

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

    <!-- Toplam Puan Kutucukları - SABİT -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/black_border">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="2dp">

            <!-- Toplam Puan Takım 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="#E3F2FD"
                android:layout_marginEnd="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOPLAM: "
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2" />

            </LinearLayout>

            <!-- Toplam Puan Takım 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="#F1F8E9"
                android:layout_marginStart="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOPLAM: "
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#388E3C" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#388E3C" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- Galibiyet Butonları - SABİT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp">

        <!-- Takım 1 Galip -->
        <Button
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="TAKIM 1 GALİP"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="#E3F2FD"
            android:textColor="#1976D2"
            android:layout_marginEnd="2dp" />

        <!-- Berabere -->
        <Button
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="BERABERE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp" />

        <!-- Takım 2 Galip -->
        <Button
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="TAKIM 2 GALİP"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="#F1F8E9"
            android:textColor="#388E3C"
            android:layout_marginStart="2dp" />

    </LinearLayout>

    <!-- Alt Butonlar - Ekranın En Altında -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="0dp">

        <!-- İptal Butonu -->
        <Button
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="İPTAL"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#F44336"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp" />

        <!-- Kaydet Butonu -->
        <Button
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="KAYDET"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>