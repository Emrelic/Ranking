<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardElevation="4dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Eşleşme numarası -->
        <TextView
            android:id="@+id/tv_match_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Eşleşme"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="8dp" />

        <!-- Ana eşleştirme alanı - Row layout with spacedBy(8dp) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- İlk takım - weight(1f) Box ile TeamCardContent -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <!-- TeamCardContent burada olacak - Tablo formatında -->
                <include layout="@layout/team_card_content"
                    android:id="@+id/team1_card" />

                <!-- Puan rozeti sol alt köşe (EMRE_CORRECT için) -->
                <TextView
                    android:id="@+id/tv_team1_points"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="4dp"
                    android:background="@drawable/score_badge_background"
                    android:text="2p"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- VS Column - V above S -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="V"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />

            </LinearLayout>

            <!-- İkinci takım - weight(1f) Box ile TeamCardContent -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <!-- TeamCardContent burada olacak - Tablo formatında -->
                <include layout="@layout/team_card_content"
                    android:id="@+id/team2_card" />

                <!-- Puan rozeti sağ alt köşe (EMRE_CORRECT için) -->
                <TextView
                    android:id="@+id/tv_team2_points"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="4dp"
                    android:background="@drawable/score_badge_background"
                    android:text="1p"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>